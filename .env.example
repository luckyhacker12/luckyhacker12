# ---------------------------------------------------------------------------
# CALLPRO CRM - server-side environment
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API).  NEVER commit the real `.env` file.
#
# The frontend does NOT read these variables at build time. It fetches the
# public URL + anon key from GET /api/config at runtime, so you can add
# credentials to a running deployment without rebuilding the image.
# ---------------------------------------------------------------------------

# Public project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Public anon / publishable key. Safe to send to the browser (RLS protects data).
SUPABASE_ANON_KEY=
# SECRET service-role key. SERVER ONLY. Never send this to the browser,
# never prefix it with VITE_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# HTTP port the Express server binds to (must match the deployment port).
PORT=3000
