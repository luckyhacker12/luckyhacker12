{
  "name": "callpro-crm",
  "version": "1.0.0",
  "private": true,
  "description": "CALLPRO CRM - calling-center CRM with Supabase Auth + row-level security",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch server/index.mjs\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^7.3.7"
  }
}
